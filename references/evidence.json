  "claims": {
    "osaka.scope": {
      "kind": "対象",
      "text": "大阪市樹木管理者の街路樹・公園樹を対象とする。",
      "source_ids": [
        "osaka-scope"
      ],
      "status": "checked"
    },
    "osaka.exclusion": {
      "kind": "除外",
      "text": "大阪港湾局所管の街路樹・臨港緑地等は適用対象から除外される。",
      "source_ids": [
        "osaka-scope"
      ],
      "status": "checked"
    },
    "osaka.inspection": {
      "kind": "判定区分",
      "text": "樹木点検の区分はA/B/要診断木/D2。",
      "source_ids": [
        "osaka-inspection"
      ],
      "status": "checked"
    },
    "osaka.target": {
      "kind": "適用条件",
      "text": "樹木医診断は、点検・フォローアップで要診断木となった高木が対象。",
      "source_ids": [
        "osaka-target"
      ],
      "status": "checked"
    },
    "osaka.overall": {
      "kind": "判定区分",
      "text": "樹木医診断の総合判定はA/B/C/D1/D2。",
      "source_ids": [
        "osaka-overall"
      ],
      "status": "checked"
    },
    "osaka.followup": {
      "kind": "判定区分",
      "text": "フォローアップ点検の区分はB/要診断木/D2。",
      "source_ids": [
        "osaka-followup"
      ],
      "status": "checked"
    },
    "osaka.conflict": {
      "kind": "資料内不一致",
      "text": "D2の名称は表6-1では危険木、同頁6.5の本文では枯死。名称を独断で統一しない。",
      "source_ids": [
        "osaka-followup"
      ],
      "status": "conflict"
    },
    "hokkaido.second": {
      "kind": "判定区分",
      "text": "様式2の二次診断欄はA/B1/B2/C。",
      "source_ids": [
        "hokkaido-form"
      ],
      "status": "checked"
    },
    "hokkaido.third": {
      "kind": "判定区分",
      "text": "様式2の三次診断欄はA/B1/B2/B3/C。B3を含む。",
      "source_ids": [
        "hokkaido-form"
      ],
      "status": "checked"
    },
    "hitachi.text": {
      "kind": "数値条件",
      "text": "早期・優先撤去の選定条件の本文は腐朽率40%超。",
      "source_ids": [
        "hitachi-text"
      ],
      "status": "checked"
    },
    "hitachi.table": {
      "kind": "数値条件",
      "text": "表5では腐朽率40%以上を機器診断区分Cとしている。",
      "source_ids": [
        "hitachi-table"
      ],
      "status": "checked"
    },
    "hitachi.conflict": {
      "kind": "資料内不一致",
      "text": "40%ちょうどは本文の条件と表5の境界が一致しない。優先撤去への適用は確定せず、管理者への確認が必要。",
      "source_ids": [
        "hitachi-text",
        "hitachi-table"
      ],
      "status": "conflict"
    }
  },
